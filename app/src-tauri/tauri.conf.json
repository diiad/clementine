{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clémentine",
  "version": "0.1.0",
  "identifier": "io.github.diadieudoucoure.clementine",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Drag, hold a key, drop: local file conversion",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": ["icons/tray.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {}
}
