{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clémentine",
  "version": "0.2.1",
  "identifier": "io.github.diadieudoucoure.clementine",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Drag, hold a key, drop: local file conversion",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "icons/tray.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0N0VDQUJGRkY4NUYxM0QKUldROThZWC92OHArSkFxZFRxdEc2V3I5RG9XOUs3T0haYWtwOTBnV1FkcXNPSTducXd2aFRZWVcK",
      "endpoints": [
        "https://github.com/diiad/clementine-mac/releases/download/updater/{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
